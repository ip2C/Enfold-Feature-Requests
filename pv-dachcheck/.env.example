# Kopieren nach .env und ausfüllen. Die .env niemals committen!

PORT=3000
PUBLIC_BASE_URL=https://solar.example.de
# Seiten, die die App per iframe einbetten dürfen (Leerzeichen-getrennt)
ALLOWED_FRAME_ANCESTORS=https://www.example.de

COMPANY_NAME=Muster Solar GmbH
COMPANY_PHONE=0123 456789
COMPANY_EMAIL=info@example.de
PRIVACY_URL=https://www.example.de/datenschutz

# --- Google ---
# Browser-Schlüssel: Maps JavaScript API, Places API (New), Geocoding API.
# In der Cloud Console auf HTTP-Referrer eurer Domain beschränken!
GOOGLE_MAPS_BROWSER_KEY=
# Server-Schlüssel: nur Solar API, auf die Server-IP beschränken.
GOOGLE_SOLAR_SERVER_KEY=

# --- KI-Fotoanalyse (Anthropic Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- E-Mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Muster Solar <solar@example.de>"
SALES_NOTIFY_TO=vertrieb@example.de

# --- Vertriebs-Dashboard (/admin.html) ---
# Langes Zufallspasswort, z. B.: openssl rand -hex 24
ADMIN_TOKEN=

# Optional: jeden Lead zusätzlich an CRM / n8n / Zapier / Make senden
LEAD_WEBHOOK_URL=

# --- Rechenannahmen (optional, Defaults siehe server/config.js) ---
# PV_ELECTRICITY_PRICE=0.35
# PV_FEED_IN_TARIFF=0.078
# PV_COST_PER_KWP_SMALL=1500
# PV_COST_PER_KWP_LARGE=1300
# PV_STORAGE_COST_PER_KWH=650
# PV_SPECIFIC_YIELD=950
